# Postgres (Neon in production: use the pooled connection string)
DATABASE_URL=postgres://postgres@127.0.0.1:54329/claude_obs

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3100

# Google OAuth client (console.cloud.google.com → Credentials → OAuth client ID → Web)
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may use the app. Comma-separated e-mails and/or @domain entries for leads (Claude account owners);
# leads can sign in and create workspaces. People a lead invites can sign in to view those workspaces only.
# Leave empty to allow any Google account.
ALLOWED_EMAILS=

# Local development only: enables email/password sign-in so the app can be tried without Google.
# Ignored when NODE_ENV=production.
DEV_PASSWORD_LOGIN=1

# Protects /api/cron/* (Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=generate-a-random-string

# Optional: alert e-mails via Resend
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@example.com

# Optional: weekly AI digest (aggregates only, never content)
ANTHROPIC_API_KEY=
